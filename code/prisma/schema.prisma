// Prisma schema for TestNauti
// Database: PostgreSQL (Vercel Postgres or Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model - minimal, uses Clerk for auth
model User {
  id        String   @id // Clerk user ID
  email     String?
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts ExamAttempt[]

  @@map("users")
}

// Exam attempt tracking
model ExamAttempt {
  id                String   @id @default(cuid())
  userId            String
  examId            String
  examTitle         String
  score             Int // Number of correct answers
  totalQuestions    Int
  percentage        Int // Calculated percentage
  timeTakenSeconds  Int? // Null if untimed
  wasTimed          Boolean  @default(false)
  wasAutoSubmitted  Boolean  @default(false)
  completedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([examId])
  @@index([completedAt])
  @@map("exam_attempts")
}

